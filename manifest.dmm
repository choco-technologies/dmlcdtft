# Include dynamically generated versions list from latest release
$include https://github.com/choco-technologies/dmlcdtft/releases/download/vlatest/versions.dmm

# Module entries with version placeholder - expanded by $version-available.
# Both the core module and the port use <cpu_family> here, not <arch_name>:
# the release workflow packages this repo per DMOD_CPU_FAMILY, not per full
# architecture (see dmfmc/manifest.dmm or dmuart/manifest.dmm for the
# real-world reference).
dmlcdtft      https://github.com/choco-technologies/dmlcdtft/releases/download/v<version>/dmlcdtft-v<version>-<cpu_family>.zip
dmlcdtft_port https://github.com/choco-technologies/dmlcdtft/releases/download/v<version>/dmlcdtft_port-v<version>-<cpu_family>.zip

# On-target test application (see tools/lcdtest) - its own DMOD module/package.
lcdtest       https://github.com/choco-technologies/dmlcdtft/releases/download/v<version>/lcdtest-v<version>-<cpu_family>.zip
